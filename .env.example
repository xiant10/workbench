# Required
DATABASE_URL=postgres://workbench:workbench-dev-password@localhost:5433/workbench?sslmode=disable
AUTH_PUBLIC_URL=http://localhost:8081
AUTH_CLIENT_SECRET=dev-only-t10-workbench-client-secret-change-me
WORKBENCH_PUBLIC_URL=http://127.0.0.1:8083
# 32 bytes of base64 from `openssl rand -base64 32`. It encrypts stored tokens.
WORKBENCH_SESSION_KEY=
# name=url pairs. The first agent is the default. A name can also be a replica,
# such as assistant.r1, and sessions of that replica go there.
AGENT_URLS=assistant=http://localhost:9800
# With more than one agent-pi replica, name ai-gateway-agent instead:
# AGENT_URLS=assistant=http://localhost:7201

# Optional
# AUTH_URL=                     where this service reaches auth, if not AUTH_PUBLIC_URL
# AUTH_CLIENT_ID=t10-workbench
# WORKBENCH_LISTEN_ADDR=:8083
# AGENT_PROFILES=chat           profiles a person can pick, first is the default
# MODULE_URLS=collab=http://localhost:8082   business modules, id=url,id=url. Unset hides them
# LIVEKIT_URL=ws://localhost:8890    unset hides calls. Added to the content security policy
# OTEL_EXPORTER_OTLP_ENDPOINT=  an OTLP/gRPC host:port. Unset turns telemetry off
